# CINAI backend settings. Copy to .env and replace placeholders before use.
PROJECT_NAME="CINAI Platform"
API_V1_STR="/api"
SECRET_KEY=replace-with-a-random-secret-before-running
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local development defaults to SQLite. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./cinai.db
# Optional absolute SQLite path, for example D:\DACS2\backend\cinai.db
# DATABASE_PATH=

# AI services. Keep real keys in backend/.env only.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Optional xAI Grok provider for story generation.
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-4.7
STABILITY_API_KEY=your_stability_api_key_here
FPT_AI_API_KEY=your_fpt_ai_key_here

# Google Identity Services sign-in. Set this to the OAuth 2.0 Web client ID.
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Social analytics OAuth. The callback URLs use SOCIAL_OAUTH_BASE_URL.
SOCIAL_OAUTH_BASE_URL=http://localhost:8000
SOCIAL_YOUTUBE_CLIENT_ID=your_youtube_oauth_client_id_here
SOCIAL_YOUTUBE_CLIENT_SECRET=your_youtube_oauth_client_secret_here
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_GRAPH_VERSION=v24.0

# OTP email delivery (SMTP). Use an app password where the provider requires it.
SMTP_HOST=your_smtp_host_here
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=your_sender_email_here
SMTP_USE_SSL=false

# OTP SMS delivery (Twilio). Phone numbers must be enabled for your Twilio account.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_phone_number_here

# Local media storage and renderer.
STORAGE_LOCAL_DIR=./storage
FFMPEG_PATH=ffmpeg
